# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Not used until the Team module.
SUPABASE_SERVICE_ROLE_KEY=

# AI follow-up (server-only — never prefix with NEXT_PUBLIC_). Leave empty to disable AI features.
OPENAI_API_KEY=
# Optional: model for scoring + drafts (must support Structured Outputs)
OPENAI_MODEL=gpt-4o-mini
# Optional: Azure OpenAI / gateway / proxy endpoint
OPENAI_BASE_URL=
# Optional: per-user cap on AI calls per hour (cost protection)
AI_HOURLY_LIMIT_PER_USER=60

# Used to build email links (signup confirmation, password reset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pipeline Review Tracker (Google Sheets, two-way). Server-only.
# Service account from Google Cloud; share the sheet with its email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the service account's JSON key (keep the 
 line breaks)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# From the sheet URL: /spreadsheets/d/<PIPELINE_SHEET_ID>/edit#gid=<PIPELINE_SHEET_GID>
PIPELINE_SHEET_ID=
PIPELINE_SHEET_GID=
